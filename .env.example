# Optional configuration for ./traced, run from the common EDTH root.
# Copy to .env only when you want to configure the root launcher.
# Unset values fall back to evidence-explorer/.env; process environment wins.
# Relative data paths in THIS file resolve from EDTH. The existing store stays put.
# Uncomment to explicitly select the usual store, or supply another existing store:
# EVIDENCE_DATA_DIR=./evidence-explorer/data
# Earlier Trail store: ./evidence-explorer/data/evidence-trail

# Uncomment only settings you want to override from evidence-explorer/.env.
# EVIDENCE_HOST=127.0.0.1
# TRACED_PORT=8053
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EVIDENCE_EMBEDDING_MODEL=bge-m3
# EVIDENCE_CHAT_MODEL=qwen3.5:9b

# Optional provider keys use the same names as evidence-explorer/.env.example.
# Do not put credentials into tracked files. Configuration output shows paths only.

# Maltego Data MCP (docs/MALTEGO_DATA_SOURCE.md). No key belongs here: each person
# runs ./traced maltego login once; the token file stays outside the project.
# Defaults shown; uncomment only to override.
# TRACED_MALTEGO_MCP_URL=https://datamcp.maltego.com/mcp
# TRACED_MALTEGO_CLIENT_ID=maltego-datamcp-mcp
# TRACED_MALTEGO_CALLBACK_PORT=33418
# TRACED_MALTEGO_TIMEOUT_SECONDS=300
# TRACED_MALTEGO_TOKEN_FILE=/absolute/path/outside/the/project/maltego-token.json
