# Railway Deployment Environment Variables for Traced
# Copy this file to .env and configure for your deployment
# Do NOT commit this file with actual credentials

# =============================================================================
# COMMON CONFIGURATION - Used by all services
# =============================================================================

# Host to bind to (Railway requires 0.0.0.0)
EVIDENCE_HOST=0.0.0.0

# Data directory (mounted volume in Railway)
EVIDENCE_DATA_DIR=/app/data

# Read-only mode (set to "true" for production if you don't need writes)
EVIDENCE_READ_ONLY=false

# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# INTEGRATED WORKSPACE CONFIGURATION
# =============================================================================

# Port for integrated workspace (default: 8000)
TRACED_PORT=8000

# =============================================================================
# EVIDENCE EXPLORER CONFIGURATION
# =============================================================================

# Port for Evidence Explorer standalone (default: 8050)
EVIDENCE_PORT=8050

# Ollama API URL (leave empty to disable AI features)
# For Railway, you would need to deploy Ollama separately or use a cloud provider
OLLAMA_BASE_URL=

# Embedding model (default: bge-m3)
EVIDENCE_EMBEDDING_MODEL=bge-m3

# Chat/analysis model (default: qwen3.5:9b)
EVIDENCE_CHAT_MODEL=qwen3.5:9b

# OpenRouter API key (optional, leave empty to disable)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model for review (optional)
EVIDENCE_REVIEW_MODEL=

# =============================================================================
# SOCIAL MEDIA API CONFIGURATION (Optional)
# =============================================================================

# X/Twitter Bearer Token (optional)
# Get from: https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=

# Reddit API credentials (optional)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:local.evidence-explorer:v0.1.0 (by /u/YOUR_USERNAME)

# =============================================================================
# SWARM DETECTOR CONFIGURATION
# =============================================================================

# Port for Swarm Detector (default: 8051)
SWARM_PORT=8051

# Data directory for Swarm Detector
SWARM_DATA_DIR=/var/data

# Basic Authentication (optional, leave empty to disable)
# Set both user and password, or neither
SWARM_BASIC_AUTH_USER=
SWARM_BASIC_AUTH_PASSWORD=

# =============================================================================
# SILENT STORM CONFIGURATION
# =============================================================================

# Port for Silent Storm (default: 8052)
SILENT_STORM_PORT=8052

# Database path
SILENT_STORM_DB_PATH=/app/silent-storm.db

# Dataset root directory
SILENT_STORM_DATASET_ROOT=/app/dataset

# =============================================================================
# MALTEGO DATA MCP CONFIGURATION (Optional)
# =============================================================================

# Maltego Data MCP URL
TRACED_MALTEGO_MCP_URL=https://datamcp.maltego.com/mcp

# Maltego client ID
TRACED_MALTEGO_CLIENT_ID=maltego-datamcp-mcp

# Maltego callback port
TRACED_MALTEGO_CALLBACK_PORT=33418

# Maltego timeout in seconds
TRACED_MALTEGO_TIMEOUT_SECONDS=300

# Path to Maltego token file (must be outside the project)
TRACED_MALTEGO_TOKEN_FILE=/tmp/maltego-token.json

# =============================================================================
# SUPABASE CONFIGURATION (Optional)
# =============================================================================

# Supabase connection details
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=

# Supabase project reference (for pooler)
SUPABASE_PROJECT_REF=

# Column mappings (optional, adjust based on your schema)
SUPABASE_ID_COLUMN=id
SUPABASE_TEXT_COLUMN=content
SUPABASE_TITLE_COLUMN=title
SUPABASE_URL_COLUMN=url
SUPABASE_PUBLISHED_AT_COLUMN=published_at
SUPABASE_AUTHOR_COLUMN=author

# =============================================================================
# RAILWAY-SPECIFIC NOTES
# =============================================================================

# 1. For Railway deployments:
#    - Set these variables in the Railway dashboard under "Variables"
#    - Mark sensitive variables (API keys, passwords) as "Secret"
#    - Use the Railway volume for persistent storage

# 2. Volume configuration:
#    - Create a volume named "traced-data" for the integrated workspace
#    - Mount at /app/data
#    - Recommended size: 10 GB

# 3. To deploy:
#    - Connect your GitHub repository to Railway
#    - Railway will automatically detect the Dockerfile
#    - Set the environment variables above
#    - Deploy!

# 4. For individual service deployments:
#    - Use the respective Dockerfiles:
#      * evidence-explorer/Dockerfile (port 8050)
#      * swarm-detector/Dockerfile (port 8051)
#      * operation-silent-storm/Dockerfile (port 8052)
#    - Or use the railway-*.json configuration files

# 5. Health checks:
#    - All services expose /health endpoint
#    - Railway will automatically monitor this

# =============================================================================
