      "link": "#276B63",
      "linkOnDark": "#A7D7CD",
      "selectionBackground": "#D9E9E4",
      "selectionForeground": "#142229",
      "focusRing": "#142229",
      "focusRingOnDark": "#F4F3EE",
      "focusAccent": "#F36643",
