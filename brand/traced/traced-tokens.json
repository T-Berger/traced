  },
  "layout": {
    "contentMax": "1280px",
    "readingMax": "68ch",
    "controlHeight": "44px",
    "sidebarWidth": "264px"
  },
  "accessibility": {
    "method": "WCAG sRGB relative luminance contrast calculation",
    "contrast": {
      "ink on paper": {
        "ratio": 14.65,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "ink on white": {
        "ratio": 16.27,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "paper on ink": {
        "ratio": 14.65,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "ink on trace": {
        "ratio": 5.26,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "white on trace": {
        "ratio": 3.09,
        "normalTextAA": false,
        "largeTextOrUIBoundaryAA": true
      },
      "trace on paper": {
        "ratio": 2.78,
        "normalTextAA": false,
        "largeTextOrUIBoundaryAA": false
      },
      "trace on ink": {
        "ratio": 5.26,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "slate on paper": {
        "ratio": 5.63,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "slate on white": {
        "ratio": 6.25,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "white on moss": {
        "ratio": 6.23,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "moss on paper": {
        "ratio": 5.61,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "line on paper": {
        "ratio": 1.21,
        "normalTextAA": false,
        "largeTextOrUIBoundaryAA": false
      },
      "success status label": {
        "ratio": 6.61,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "review status label": {
        "ratio": 6.73,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "error status label": {
        "ratio": 6.83,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "info status label": {
        "ratio": 7.73,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "ink on trace hover": {
        "ratio": 4.77,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      },
      "ink on trace active": {
        "ratio": 4.67,
        "normalTextAA": true,
        "largeTextOrUIBoundaryAA": true
      }
    },
    "rules": [
      "Use Ink text on Trace action backgrounds. White text on Trace fails normal text AA.",
      "Use Moss or Ink for links on light surfaces; underline links in body copy.",
      "Use Ink focus rings on light surfaces and Paper focus rings on dark surfaces. Trace alone is not a sufficient focus boundary against Paper.",
      "Line is a decorative divider color only; use Slate for essential input outlines and controls.",
      "Semantic labels always combine text with color. Success means an action completed; it is not a truth verdict.",
      "Do not reduce text opacity to create secondary text. Use the Slate token."
    ]
  }
}
