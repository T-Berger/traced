        "letterSpacing": "0"
      },
      "lead": {
        "fontFamily": "sans",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "-0.01em"
      },
      "heading": {
        "fontFamily": "sans",
        "fontSize": "32px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.025em"
      },
      "display": {
        "fontFamily": "sans",
        "fontSize": "48px",
        "fontWeight": 700,
        "lineHeight": 1.08,
        "letterSpacing": "-0.04em"
      }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
