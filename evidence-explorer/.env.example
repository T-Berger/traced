# Copy to .env; all model requests remain local by default.
EVIDENCE_DATA_DIR=./data
OLLAMA_BASE_URL=http://127.0.0.1:11434
EVIDENCE_EMBEDDING_MODEL=bge-m3
EVIDENCE_CHAT_MODEL=qwen3.5:9b
EVIDENCE_HOST=127.0.0.1
EVIDENCE_PORT=8051
EVIDENCE_READ_ONLY=false

# Evidence Trail review: local Ollama is the first live provider.
# Uses OLLAMA_BASE_URL and EVIDENCE_CHAT_MODEL above; no API key is needed.
EVIDENCE_REVIEW_DB=./data/evidence.sqlite3

# Optional cloud review. Leave empty to keep OpenRouter unavailable.
# Requests run only when OpenRouter is explicitly selected in the review UI.
OPENROUTER_API_KEY=
EVIDENCE_REVIEW_MODEL=

# Optional official read-only social APIs, shared by Live sources and Saved feeds.
# Leave empty to show setup-needed; credentials stay on the server, not in evidence.
# Platform account/app approval and API access are managed by X and Reddit.
# Presence of credentials does not confirm platform approval or endpoint access.
# Telegram public previews and YouTube public Atom feeds need no credentials.
X_BEARER_TOKEN=

# Reddit requires approved API access. Use an access token OR app credentials.
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Set a truthful descriptive agent, e.g.
# python:local.evidence-explorer:v0.1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_USER_AGENT=
