{
  "name": "evidence-explorer",
  "description": "Evidence Explorer - News and feed evidence collection, analysis, and review dashboard",
  "service": {
    "name": "evidence-explorer",
    "type": "web",
    "dockerfile": "evidence-explorer/Dockerfile",
    "dockerContext": ".",
    "port": 8050,
    "healthCheckPath": "/health",
    "healthCheckTimeout": 5,
    "healthCheckInterval": 30,
    "startupProbe": {
      "path": "/health",
      "initialDelaySeconds": 30,
      "periodSeconds": 10,
      "failureThreshold": 20
    },
    "environment": {
      "EVIDENCE_HOST": "0.0.0.0",
      "EVIDENCE_PORT": "8050",
      "EVIDENCE_DATA_DIR": "/app/data",
      "EVIDENCE_READ_ONLY": "false",
      "OLLAMA_BASE_URL": "",
      "EVIDENCE_EMBEDDING_MODEL": "bge-m3",
      "EVIDENCE_CHAT_MODEL": "qwen3.5:9b"
    },
    "volumes": [
      {
        "name": "explorer-data",
        "mountPath": "/app/data",
        "sizeGB": 10
      }
    ],
    "resources": {
      "cpu": 2,
      "memoryGB": 4
    },
    "autoDeploy": true
  },
  "notes": "Evidence Explorer provides: news/RSS/Atom feed collection, Telegram public channel monitoring, YouTube channel metadata gathering, article analysis with Ollama, keyword search, vector similarity search, and evidence review workflows. This is the core evidence management dashboard.",
  "envVars": {
    "EVIDENCE_DATA_DIR": {
      "description": "Path to the data directory",
      "value": "/app/data"
    },
    "EVIDENCE_READ_ONLY": {
      "description": "Set to 'true' for read-only mode",
      "value": "false"
    },
    "OLLAMA_BASE_URL": {
      "description": "URL for Ollama API (leave empty to disable AI features)",
      "value": ""
    },
    "EVIDENCE_EMBEDDING_MODEL": {
      "description": "Model for embedding generation",
      "value": "bge-m3"
    },
    "EVIDENCE_CHAT_MODEL": {
      "description": "Model for chat/analysis",
      "value": "qwen3.5:9b"
    }
  }
}
