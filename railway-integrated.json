{
  "name": "traced-integrated",
  "description": "Traced Evidence Workbench - Complete integrated workspace with all dashboards (Evidence Explorer, Swarm Detector, Silent Storm)",
  "service": {
    "name": "traced-integrated",
    "type": "web",
    "dockerfile": "Dockerfile",
    "dockerContext": ".",
    "port": 8000,
    "healthCheckPath": "/health",
    "healthCheckTimeout": 5,
    "healthCheckInterval": 30,
    "startupProbe": {
      "path": "/health",
      "initialDelaySeconds": 45,
      "periodSeconds": 10,
      "failureThreshold": 30
    },
    "environment": {
      "EVIDENCE_HOST": "0.0.0.0",
      "TRACED_PORT": "8000",
      "EVIDENCE_DATA_DIR": "/app/data",
      "EVIDENCE_READ_ONLY": "false",
      "PYTHONUNBUFFERED": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "volumes": [
      {
        "name": "traced-data",
        "mountPath": "/app/data",
        "sizeGB": 10
      }
    ],
    "resources": {
      "cpu": 2,
      "memoryGB": 4
    },
    "autoDeploy": true
  },
  "notes": "This is the main integrated Traced workspace. It provides access to ALL dashboards: Evidence Explorer (news/feed evidence), Swarm Detector (Telegram coordination analysis), and Silent Storm (historical media inspection). All features are accessible through the unified interface at the root URL.",
  "envVars": {
    "EVIDENCE_DATA_DIR": {
      "description": "Path to the data directory",
      "value": "/app/data"
    },
    "EVIDENCE_READ_ONLY": {
      "description": "Set to 'true' for read-only mode",
      "value": "false"
    },
    "TRACED_PORT": {
      "description": "Port the application listens on",
      "value": "8000"
    }
  }
}
