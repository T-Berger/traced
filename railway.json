{
  "name": "traced",
  "description": "Traced Evidence Workbench - Complete integrated workspace with all dashboards",
  "service": {
    "name": "traced",
    "type": "web",
    "dockerfile": "Dockerfile",
    "dockerContext": ".",
    "port": 8000,
    "healthCheckPath": "/health",
    "healthCheckTimeout": 5,
    "healthCheckInterval": 30,
    "startupProbe": {
      "path": "/health",
      "initialDelaySeconds": 45,
      "periodSeconds": 10,
      "failureThreshold": 30
    },
    "environment": {
      "EVIDENCE_HOST": "0.0.0.0",
      "EVIDENCE_DATA_DIR": "/app/data",
      "EVIDENCE_READ_ONLY": "false",
      "PYTHONUNBUFFERED": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "volumes": [
      {
        "name": "traced-data",
        "mountPath": "/app/data",
        "sizeGB": 10
      }
    ],
    "resources": {
      "cpu": 2,
      "memoryGB": 4
    },
    "autoDeploy": true
  }
}
