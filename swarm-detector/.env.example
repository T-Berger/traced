# Native development: uv run --env-file .env swarm-detector serve
# Compose reads .env for the two explicitly forwarded authentication values.
SWARM_DATA_DIR=./data
# Optional override; otherwise the database is <SWARM_DATA_DIR>/swarm.db.
# SWARM_DB_PATH=/absolute/path/to/swarm.db
PORT=8050
# Leave BOTH empty for local use, or configure BOTH before exposing the service.
SWARM_BASIC_AUTH_USER=
SWARM_BASIC_AUTH_PASSWORD=
